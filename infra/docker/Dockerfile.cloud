# ============================================================
# Dockerfile — Cloud API (FastAPI)
# ============================================================
FROM python:3.11-slim

# Set work directory
WORKDIR /app

# Install system deps (needed by some Python packages)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (layer cache: only re-install if requirements change)
COPY cloud/requirements.txt ./cloud/requirements.txt
RUN pip install --no-cache-dir -r cloud/requirements.txt

# Copy all source code
COPY cloud/ ./cloud/
COPY .env.example ./.env.example

# Create non-root user for security
RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -sf http://localhost:8000/health || exit 1

# Start server (run with multiple workers in production)
CMD ["uvicorn", "cloud.services.vehicle-registry.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "2", "--log-level", "info"]
