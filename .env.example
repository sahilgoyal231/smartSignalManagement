# ============================================================
# 🚦 Smart Signal System — Environment Variables Template
# Copy this to .env and fill in real values. NEVER commit .env
# ============================================================

# --- Project ---
PROJECT_NAME=SmartSignalSystem
ENVIRONMENT=development       # development | staging | production
LOG_LEVEL=INFO

# --- PostgreSQL (Supabase / Neon) ---
POSTGRES_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# --- InfluxDB (InfluxDB Cloud) ---
INFLUX_URL=https://[YOUR-REGION].aws.cloud2.influxdata.com
INFLUX_TOKEN=[YOUR-INFLUXDB-CLOUD-TOKEN]
INFLUX_ORG=SmartSignal
INFLUX_BUCKET=telemetry

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# --- MQTT Broker (HiveMQ Cloud) ---
MQTT_BROKER_HOST=[YOUR-CLUSTER].s2.eu.hivemq.cloud
MQTT_BROKER_PORT=8883          # TLS port
MQTT_BROKER_USER=[YOUR-USERNAME]
MQTT_BROKER_PASSWORD=[YOUR-PASSWORD]
MQTT_CLIENT_ID_PREFIX=cloud-service

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=RS256
JWT_EXPIRE_MINUTES=60


# --- Device Certificate Authority ---
CA_CERT_PATH=./certs/ca.crt
CA_KEY_PATH=./certs/ca.key     # Keep this EXTREMELY secure

# --- Edge Node ---
EDGE_NODE_ID=NODE-TEST-001
SIGNAL_CTRL_SERIAL_PORT=/dev/ttyUSB0
SIGNAL_CTRL_BAUD_RATE=9600
PREEMPT_THRESHOLD_SECONDS=45
ALERT_THRESHOLD_SECONDS=90
MAX_GREEN_HOLD_SECONDS=60

# --- VSU ---
VSU_VEHICLE_ID=TEST-AMB-001
VSU_VEHICLE_TYPE=AMBULANCE
VSU_PRIORITY_CLASS=2
GPS_SERIAL_PORT=/dev/serial0
GPS_BAUD_RATE=9600
LORA_SPI_CHANNEL=0
